 "phrases": [
  {
   "start": 0.07,
   "end": 2.57,
   "text": "Sir, apne paas aane waale 10 patients mein se",
   "section": "question"
  },
  {
   "start": 2.93,
   "end": 4.81,
   "text": "6 se 7-8 patients diabetic rehte hain.",
   "section": "question"
  },
  {
   "start": 5.163,
   "end": 6.683,
   "text": "Aajkal apne desh mein diabetes",
   "section": "question"
  },
  {
   "start": 6.93,
   "end": 8.8,
   "text": "ke patients itne kyun badh rahe hain? Sir, kya kaaran hai?",
   "section": "question"
  },
  {
   "start": 9.003,
   "end": 9.923,
   "text": "Charakacharya ji ne",
   "section": "charaka"
  },
  {
   "start": 10.263,
   "end": 11.333,
   "text": "kisko diabetes hota hai,",
   "section": "charaka"
  },
  {
   "start": 11.664,
   "end": 12.734,
   "text": "kisko madhumeh hota hai,",
   "section": "charaka"
  },
  {
   "start": 13.097,
   "end": 13.847,
   "text": "yeh bataya hua hai.",
   "section": "charaka"
  },
  {
   "start": 14.037,
   "end": 15.897,
   "text": "Woh chinta mein apna vyapaar karta hai,",
   "section": "stress"
  },
  {
   "start": 16.23,
   "end": 17.62,
   "text": "aur woh vyapaar karte samay",
   "section": "stress"
  },
  {
   "start": 17.963,
   "end": 18.803,
   "text": "uska jo stress hai,",
   "section": "stress"
  },
  {
   "start": 19.163,
   "end": 20.143,
   "text": "To iska yeh matlab hai",
   "section": "stress"
  },
  {
   "start": 20.497,
   "end": 21.277,
   "text": "ki stress hi",
   "section": "stress"
  },
  {
   "start": 21.63,
   "end": 22.38,
   "text": "diabetes ka ek",
   "section": "stress"
  },
  {
   "start": 22.73,
   "end": 24.17,
   "text": "mahatvapurna kaaran, cause hai.",
   "section": "stress"
  },
  {
   "start": 24.37,
   "end": 26.02,
   "text": "Jo gaay se utpann",
   "section": "dairy"
  },
  {
   "start": 26.363,
   "end": 27.173,
   "text": "doodh,",
   "section": "dairy"
  },
  {
   "start": 27.503,
   "end": 27.893,
   "text": "dahi,",
   "section": "dairy"
  },
  {
   "start": 28.23,
   "end": 28.51,
   "text": "ghee,",
   "section": "dairy"
  },
  {
   "start": 28.86,
   "end": 30.8,
   "text": "iska jo zyada prayog karta hai,",
   "section": "dairy"
  },
  {
   "start": 31.163,
   "end": 32.933,
   "text": "use bhi diabetes hota hai.",
   "section": "dairy"
  },
  {
   "start": 33.137,
   "end": 34.727,
   "text": "Iska matlab naye chaawal ka use",
   "section": "grain"
  },
  {
   "start": 34.983,
   "end": 37.463,
   "text": "nahi karna chahiye, naye anaaj ka use nahi karna chahiye,",
   "section": "grain"
  },
  {
   "start": 37.797,
   "end": 38.727,
   "text": "kyunki uske kaaran",
   "section": "grain"
  },
  {
   "start": 39.063,
   "end": 40.083,
   "text": "kaph-kaarak hota hai.",
   "section": "grain"
  },
  {
   "start": 40.43,
   "end": 41.07,
   "text": "Kaph badhta,",
   "section": "grain"
  },
  {
   "start": 41.43,
   "end": 42.68,
   "text": "to kaph ke kaaran hi",
   "section": "grain"
  },
  {
   "start": 43.03,
   "end": 43.83,
   "text": "diabetes hota hai.",
   "section": "grain"
  },
  {
   "start": 44.037,
   "end": 45.127,
   "text": "Jo zyada meetha khaata hai,",
   "section": "sweets"
  },
  {
   "start": 45.463,
   "end": 47.073,
   "text": "jaise ganne se banayi cheez,",
   "section": "sweets"
  },
  {
   "start": 47.43,
   "end": 48.05,
   "text": "shakkar ho gaya,",
   "section": "sweets"
  },
  {
   "start": 48.367,
   "end": 49.037,
   "text": "gud ho gaya,",
   "section": "sweets"
  },
  {
   "start": 49.387,
   "end": 51.167,
   "text": "aur inse banayi meethi cheezein",
   "section": "sweets"
  },
  {
   "start": 51.517,
   "end": 52.857,
   "text": "jo baar-baar khaata hai.",
   "section": "sweets"
  },
  {
   "start": 53.037,
   "end": 54.507,
   "text": "Iska matlab sabhi log sukhi hain,",
   "section": "conclusion"
  },
  {
   "start": 54.863,
   "end": 55.563,
   "text": "sabhi stress mein hain,",
   "section": "conclusion"
  },
  {
   "start": 55.897,
   "end": 56.947,
   "text": "yahi ek kaaran maana ja sakta hai.",
   "section": "conclusion"
  }
 ],
