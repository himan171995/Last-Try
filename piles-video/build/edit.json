 "phrases": [
  {
   "start": 0.07,
   "end": 3.79,
   "text": "Woh agar acche se saaf karein, to baar-baar yeh problem nahi aati hai.",
   "section": "hook"
  },
  {
   "start": 3.97,
   "end": 8.35,
   "text": "Patient ek baar treatment kara leta hai, uska piles aur fissure ka problem theek bhi ho jaata hai,",
   "section": "question"
  },
  {
   "start": 8.687,
   "end": 12.307,
   "text": "lekin chaar-chhe mahine baad uska problem wapas, uska recurrent hota hai. Aisa kyun?",
   "section": "question"
  },
  {
   "start": 13.903,
   "end": 14.823,
   "text": "Haan, bahut baar,",
   "section": "answer"
  },
  {
   "start": 15.123,
   "end": 16.333,
   "text": "aapne jo sahi observe kiya hai,",
   "section": "answer"
  },
  {
   "start": 16.757,
   "end": 18.657,
   "text": "ki patient ek baar theek hone ke baad",
   "section": "answer"
  },
  {
   "start": 19.057,
   "end": 22.347,
   "text": "har chaar mahine, chhe mahine baad phir se usi problem par lekar aata hai.",
   "section": "answer"
  },
  {
   "start": 22.757,
   "end": 23.447,
   "text": "Iska main kaaran hai",
   "section": "answer"
  },
  {
   "start": 23.857,
   "end": 24.957,
   "text": "ki piles mein kya hota hai,",
   "section": "answer"
  },
  {
   "start": 25.357,
   "end": 27.177,
   "text": "jo anus dwaar hai, \u2026 saaf\u2026",
   "section": "answer"
  },
  {
   "start": 27.37,
   "end": 28.61,
   "text": "Jaise hum-aap subah uthte hain,",
   "section": "routine"
  },
  {
   "start": 28.97,
   "end": 29.86,
   "text": "to hum brush karte hain,",
   "section": "routine"
  },
  {
   "start": 30.257,
   "end": 31.747,
   "text": "daaton ke andar ka mal nikaalte hain,",
   "section": "routine"
  },
  {
   "start": 32.157,
   "end": 33.767,
   "text": "aankhon ke andar ke chipad nikaalte hain,",
   "section": "routine"
  },
  {
   "start": 34.19,
   "end": 35.84,
   "text": "naak saaf karte hain, kaan saaf karte hain.",
   "section": "routine"
  },
  {
   "start": 36.037,
   "end": 37.267,
   "text": "Waise hi jo \u2026",
   "section": "clean"
  },
  {
   "start": 37.69,
   "end": 39.75,
   "text": "mootra ke, jo indriyon ke jo dwaar hain,",
   "section": "clean"
  },
  {
   "start": 40.157,
   "end": 43.877,
   "text": "woh agar acche se saaf karein, to baar-baar yeh problem nahi aati hai.",
   "section": "clean"
  },
  {
   "start": 44.07,
   "end": 46.16,
   "text": "To mujhe apne patient ko bhi yahi kehna hai",
   "section": "advice"
  },
  {
   "start": 46.557,
   "end": 49.887,
   "text": "ki baar-baar anus ke \u2026, ek ungli andar daal ke",
   "section": "advice"
  },
  {
   "start": 50.29,
   "end": 52.06,
   "text": "thoda usko clean karna hamesha.",
   "section": "advice"
  },
  {
   "start": 52.237,
   "end": 55.877,
   "text": "To baar-baar yeh \u2026 jo aane waali problem, woh nahi aayegi.",
   "section": "takeaway"
  }
 ],
